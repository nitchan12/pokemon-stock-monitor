# ── Required ────────────────────────────────────────────────────────────
# Telegram Bot API token, obtained from @BotFather
BOT_TOKEN=

# Telegram chat id (user, group, or channel) to send notifications to
CHAT_ID=

# ── Optional (defaults shown) ───────────────────────────────────────────
# HTTP request timeout in seconds for outbound requests
REQUEST_TIMEOUT=15

# Alert policy: alert immediately when a product becomes available, then
# re-alert at most MAX_NOTIFY_COUNT times in total while it stays
# available, spaced at least REPEAT_INTERVAL_MINUTES apart. Counters reset
# when the product goes out of stock again.
MAX_NOTIFY_COUNT=3
REPEAT_INTERVAL_MINUTES=10

# Pause between consecutive product-page requests inside one run
REQUEST_DELAY_SECONDS=2

# Product detail pages to monitor (comma-separated). Leave blank to use the
# three Pokémon TCG MA6 pages built into src/config.py.
PRODUCT_URLS=
